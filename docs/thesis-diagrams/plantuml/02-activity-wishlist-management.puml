@startuml
!include common-activity-style.pumlinc
title 想要清单管理活动图

start
:用户浏览商品;
:检测重复购买;

if (是否发现重复) then (是)
  :显示历史购买提示;
  if (是否继续加入清单) then (否)
    :结束本次操作;
    stop
  endif
endif

:填写购买理由;
:设置冷静期;
:保存到想要清单;
:查看想要清单;

if (冷静期是否结束) then (否)
  :显示剩余冷静时间;
  stop
else (是)
  if (是否前往购买) then (是)
    :标记为已购买;
    :跳转商品页;
    stop
  else (否)
    :从清单移除;
    stop
  endif
endif
@enduml
